USE="brightness-control -cdda -dvd -debug dist-kernel dracut -embedded grub -gtk -gtk3 -haptic -introspection -joystick kwin -lua -mng -modemmanager -perl -ppp -speechd -vala -wxwidgets"

COMMON_FLAGS="-march=native -O2 -pipe -fomit-frame-pointer"
CFLAGS="${COMMON_FLAGS}"
CXXFLAGS="${COMMON_FLAGS}"
FCFLAGS="${COMMON_FLAGS}"
FFLAGS="${COMMON_FLAGS}"

LC_MESSAGES=C.UTF-8

RUSTFLAGS="${RUSTFLAGS} -C target-cpu=native"

EMERGE_DEFAULT_OPTS_PROFILE="-v --jobs-tmpdir-require-free-gb=0"
ACCEPT_KEYWORDS="~amd64"
ACCEPT_LICENSE="@BINARY-REDISTRIBUTABLE Vivaldi"

L10N="en en-GB en-US lt"
